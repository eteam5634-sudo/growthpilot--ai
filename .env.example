NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-your-openai-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paystack (recommended for Nigeria — cards, bank transfer, USSD)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PLAN_STARTER=PLN_xxxxxxxx
PAYSTACK_PLAN_PROFESSIONAL=PLN_xxxxxxxx
PAYSTACK_PLAN_AGENCY=PLN_xxxxxxxx
# Optional alias for Professional plan
PAYSTACK_PLAN_PRO=PLN_xxxxxxxx

# Stripe (optional — international checkout + webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_AGENCY=price_...

# Comma-separated emails that receive admin access on first login
ADMIN_EMAILS=you@example.com
